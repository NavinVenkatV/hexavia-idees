# Mode de l'IA dans l'outil :
#   simulation (défaut) : notes proposées calculées dans le navigateur, aucune donnée envoyée
#   claude              : appel à la fonction serveur /api/score (nécessite la clé ci-dessous)
VITE_AI_MODE=simulation

# Côté serveur uniquement (variables d'environnement Vercel). Ne jamais préfixer par VITE_ :
# tout ce qui commence par VITE_ est publié dans le code du navigateur.
ANTHROPIC_API_KEY=
# Optionnel : modèle utilisé (défaut : claude-opus-5-5)
ANTHROPIC_MODEL=
